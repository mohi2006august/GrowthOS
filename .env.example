# Copy to .env and fill in. Never commit .env.

# --- Agent -------------------------------------------------------------
# Leave unset to run the deterministic offline planner (used by `make sim`).
ANTHROPIC_API_KEY=
GROWTHOS_AGENT_MODEL=claude-opus-5-5
GROWTHOS_AGENT_EFFORT=high

# --- Guardrails (hard limits; the Guardrails screen can only tighten them) ---
SPEND_CAP_DAILY_USD=4000
MIN_RUNWAY_MONTHS=18
MAX_CAC_USD=1500
MARKETER_APPROVAL_LIMIT_USD=5000
# PRD open question: may the agent pause (never start) a campaign on a CAC anomaly?
ALLOW_AUTO_PAUSE=false

# --- Experiments ------------------------------------------------------
# Ad platforms report conversions 1-3 days late; stopping rules ignore the
# most recent CONVERSION_LAG_DAYS of data.
CONVERSION_LAG_DAYS=3

# --- Storage ----------------------------------------------------------
GROWTHOS_DB=var/growthos.db

# --- API auth ---------------------------------------------------------
# Comma-separated name:role:token triples; roles are marketer | cfo.
# Unset = local dev mode (identity taken from the X-GrowthOS-Actor header).
GROWTHOS_API_TOKENS=

# --- Copy model (FR-06) ------------------------------------------------
# template | claude | vllm
GROWTHOS_COPY_BACKEND=template
VLLM_BASE_URL=http://localhost:8001/v1
LORA_ADAPTER=brand-voice-lora
LORA_ADAPTER_VERSION=v1

# --- Ad platforms (FR-05) ----------------------------------------------
# Only the simulated backend ships today; these are read by live adapters.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_TOKEN=
LINKEDIN_ADS_TOKEN=
CUSTOMERIO_API_KEY=
WEBFLOW_TOKEN=
